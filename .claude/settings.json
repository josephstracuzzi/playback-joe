{
  "permissions": {
    "defaultMode": "default",
    "disableBypassPermissionsMode": "disable",
    "blockReadsOutsideWorkingDirectories": true,
    "allow": [
      "PowerShell(npm start)",
      "PowerShell(npm install)",
      "PowerShell(npm run build*)",
      "PowerShell(node --check *)",
      "PowerShell(git status*)",
      "PowerShell(git diff*)",
      "PowerShell(git log*)"
    ]
  }
}
